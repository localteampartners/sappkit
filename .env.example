# sappkit — env var template
#
# Copy to .env and fill in real values.
# Every var here must also be documented in ENVIRONMENT.md.
# Never commit .env — it's in .gitignore.

# --- Required ---
# EXAMPLE_DB_URL=postgres://user:pass@localhost:5432/sappkit
# EXAMPLE_API_KEY=

# --- Optional ---
# LOG_LEVEL=info
# PORT=3000
